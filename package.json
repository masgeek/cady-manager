{
  "name": "caddy-manager",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "migrate": "pnpm --filter @caddy-manager/db db:migrate",
    "migrate:generate": "pnpm --filter @caddy-manager/db db:generate",
    "seed": "pnpm --filter @caddy-manager/api seed",
    "purge": "pnpm --filter @caddy-manager/db db:purge"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
