# Required
AUTH_USERNAME=admin
AUTH_PASSWORD=
JWT_SECRET=  # generate with: openssl rand -base64 32

# Caddy Admin API
CADDY_ADMIN_TOKEN=  # optional, if Caddy admin API requires token auth

# Server
PORT=3500
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caddy
DB_USER=caddy
DB_PASSWORD=caddy

# Seed
SEED_EMAIL=admin@caddy.local
SEED_PASSWORD=  # required for `pnpm seed`
SEED_ROLE=admin
